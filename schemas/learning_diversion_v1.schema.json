{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-ri.local/schemas/learning-diversion-v1.schema.json",
  "title": "MCP-RI Learning Diversion v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diversion_id", "learner_id", "diversion_version", "created_at", "updated_at", "parent_trajectory_id", "parent_trajectory_version", "parent_concept_id", "parent_learning_objective", "diversion_concept_id", "diversion_skill_ids", "diversion_reason", "supporting_evidence_ids", "cognitive_state_reference", "behavioral_state_reference", "representation_plan_reference", "context_snapshot_id", "previous_learning_step", "previous_representation_plan_id", "original_trajectory_status", "resume_condition", "diversion_status", "progress_history", "revision_history", "evaluation_references", "created_by_decision_rule", "started_at", "last_evaluated_at", "resolved_at", "closure_reason"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "diversion_id": {"type": "string", "minLength": 1},
    "learner_id": {"type": "string", "minLength": 1},
    "diversion_version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "parent_trajectory_id": {"type": "string", "minLength": 1},
    "parent_trajectory_version": {"type": "integer", "minimum": 1},
    "parent_concept_id": {"type": "string", "minLength": 1},
    "parent_learning_objective": {"type": "string", "minLength": 1},
    "diversion_concept_id": {"type": "string", "minLength": 1},
    "diversion_skill_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "diversion_reason": {"type": "string", "minLength": 1},
    "supporting_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "cognitive_state_reference": {"type": ["object", "null"]},
    "behavioral_state_reference": {"type": ["object", "null"]},
    "representation_plan_reference": {"type": ["object", "null"]},
    "context_snapshot_id": {"type": "string", "minLength": 1},
    "previous_learning_step": {"type": "string", "minLength": 1},
    "previous_representation_plan_id": {"type": ["string", "null"]},
    "original_trajectory_status": {"enum": ["ACTIVE", "PAUSED"]},
    "resume_condition": {"type": "string", "minLength": 1},
    "diversion_status": {"enum": ["ACTIVE", "RESOLVED", "CLOSED", "CANCELLED"]},
    "progress_history": {"type": "array", "items": {"type": "object"}},
    "revision_history": {"type": "array", "items": {"type": "object"}},
    "evaluation_references": {"type": "array", "items": {"type": "object"}},
    "created_by_decision_rule": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "last_evaluated_at": {"type": ["string", "null"]},
    "resolved_at": {"type": ["string", "null"]},
    "closure_reason": {"type": ["string", "null"]}
  }
}
