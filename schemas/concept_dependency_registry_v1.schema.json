{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-ri.local/schemas/concept-dependency-registry-v1.schema.json",
  "title": "MCP-RI Concept Dependency Registry v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "registry_version", "created_at", "dependencies"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}
  },
  "$defs": {
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["dependency_id", "source_concept_id", "target_concept_id", "relationship_type", "source", "verification_status", "confidence", "created_at", "schema_version"],
      "properties": {
        "dependency_id": {"type": "string", "minLength": 1},
        "source_concept_id": {"type": "string", "minLength": 1},
        "target_concept_id": {"type": "string", "minLength": 1},
        "relationship_type": {"enum": ["PREREQUISITE", "SUPPORTING_CONCEPT", "RELATED_CONCEPT", "ADVANCED_CONCEPT"]},
        "source": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["verified", "manually_configured", "synthetic_test"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "created_at": {"type": "string", "minLength": 1},
        "schema_version": {"const": "1.0"}
      }
    }
  }
}
