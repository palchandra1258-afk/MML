{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-ri.local/schemas/evidence-alignment-v1.schema.json",
  "title": "MCP-RI Evidence Alignment Link",
  "description": "A candidate relationship between two evidence records with explicit alignment uncertainty.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "left_evidence_id", "right_evidence_id", "alignment_type", "absolute_delta_ms", "alignment_uncertainty", "uncertainty_flags"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "left_evidence_id": {"type": "string", "pattern": "^ev_[0-9a-f]{32}$"},
    "right_evidence_id": {"type": "string", "pattern": "^ev_[0-9a-f]{32}$"},
    "alignment_type": {"enum": ["explicit_related", "same_source_session", "approximate_timestamp_candidate", "uncertain_cross_source_candidate"]},
    "absolute_delta_ms": {"type": ["integer", "null"], "minimum": 0},
    "alignment_uncertainty": {"enum": ["low", "medium", "high", "unknown"]},
    "uncertainty_flags": {"type": "array", "items": {"type": "string"}}
  }
}
