# Local Phase 14 API base from docs/API_DESIGN_SPECIFICATION.md
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Set true only to use the clearly marked synthetic walkthrough on the dashboard.
# API errors never trigger a synthetic fallback.
NEXT_PUBLIC_USE_MOCK_DATA=false

# Request timeout in milliseconds (250–120000; default 10000)
NEXT_PUBLIC_API_TIMEOUT_MS=10000
